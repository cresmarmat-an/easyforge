# Win32 hands pointers to the program as integers: window data, message
# parameters, and handles. Casting them back is the API's own way. Its
# structures start as zeros and are filled field by field, as its
# documentation does, so an enumeration is zero only until it is set.
InheritParentConfig: true
Checks: '-performance-no-int-to-ptr,-bugprone-invalid-enum-default-initialization'
