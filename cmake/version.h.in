#include <string_view>

namespace easyforge
{
    struct LibraryVersion
    {
        int Major = 0;
        int Minor = 0;
        int Patch = 0;

        // Text after the numbers, such as "alpha". Empty for an official release.
        std::string_view Label;
    };

    inline constexpr LibraryVersion Version = {
        @PROJECT_VERSION_MAJOR@,
        @PROJECT_VERSION_MINOR@,
        @PROJECT_VERSION_PATCH@,
        "@EASYFORGE_VERSION_LABEL@",
    };

    // The whole version as text, for example "0.0.1", or "0.0.2-alpha" with a label.
